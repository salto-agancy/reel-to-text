# --- secrets (required) ---
TELEGRAM_BOT_TOKEN=
DEEPGRAM_API_KEY=
# HikerAPI key, https://hikerapi.com (primary Instagram provider). Empty = only yt-dlp fallback.
HIKERAPI_KEY=

# --- Instagram providers, tried left to right ---
INSTAGRAM_PROVIDERS=hikerapi,ytdlp
# optional Netscape cookies file for yt-dlp
YTDLP_COOKIES_FILE=

# --- speech-to-text ---
DEEPGRAM_MODEL=nova-3
# multi = Nova-3 multilingual (Russian + English, code switching). Or ru / en / detect
DEEPGRAM_LANGUAGE=multi

# --- beta access ---
# allowlist = only ALLOWED_USER_IDS and ADMIN_USER_IDS; open = anyone
ACCESS_MODE=allowlist
ALLOWED_USER_IDS=
# admins: no rate limits, /stats
ADMIN_USER_IDS=

# --- limits that protect the API balance ---
MAX_REEL_SECONDS=300
MAX_DOWNLOAD_MB=100
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=30
HTTP_TIMEOUT=30
STT_TIMEOUT=120

# where the cache (SQLite) and heartbeat live
DATA_DIR=data
